Maximum consective ones flipping 0 into 1 with k times

nums = [1, 0, 1, 1, 0, 1, 1, 1, 1, 0, 1, 1, 1] 

cnt = 0 ; mx = 1; left = 0 ; k = 2 
for i in range(len(nums)):
    
    if nums[i] == 0:
        cnt += 1 
        
    while cnt > k:
        if nums[left] == 0:
            cnt -=1 
        left += 1 
            
    mx = max(mx, i-left+1) 
    
print(mx) 
