from collections import Counter

s = "110"; k = 3

ans = float('-inf')

for i in range(len(s)):

    for j in range(i+k-1, len(s)): 

            mpp = Counter(s[i:j + 1])

            odd = -1
            even = float('inf')

            for val in mpp.values():

                if val % 2:
                    odd = max(odd, val)
                else:
                    even = min(even, val)

            if odd != -1 and even != float('inf'): #maintaining atleast one odd , even frequency , if it calculates high 
                ans = max(ans, odd - even)

        j += 1

print(ans) 

